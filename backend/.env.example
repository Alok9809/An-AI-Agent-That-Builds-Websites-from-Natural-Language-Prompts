# ==============================================================================
# FORMA Authentication & Backend Configuration
# Tagline: "Give thought its form."
# ==============================================================================

# Environment: 'development', 'test', or 'production'
ENV=development

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=forma_auth

# Application URLs & CORS
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Cryptographic Session Secrets (Must be at least 32 characters in production)
SESSION_SECRET=forma_super_secure_session_secret_key_minimum_32_characters_long_98765

# Cookie & Session Settings
SESSION_COOKIE_NAME=forma_session
SESSION_MAX_AGE_SECONDS=604800
SESSION_REMEMBER_ME_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Password Reset & Email Verification Expirations (in minutes)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_EMAIL_VERIFICATION=false

# Email Delivery Configuration: 'console', 'smtp', or 'mock'
# If SMTP credentials are blank, links are logged to console & test outbox.
EMAIL_PROVIDER=console
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@forma.ai
SMTP_TLS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_FORGOT_MAX=3
RATE_LIMIT_FORGOT_WINDOW_SECONDS=300

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
