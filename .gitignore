# ==============================================================================
# Root .gitignore - FORMA AI Website Planner
# ==============================================================================

# Environment variables & sensitive credentials
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.pfx
secrets.*
*credentials*.txt
env_credentials.txt

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
!frontend/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.vite/
frontend/.vite/

# Editor & IDE configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & Diagnostics
logs/
*.log
